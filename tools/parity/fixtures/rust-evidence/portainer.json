[
  {
    "checks": {
      "bootstrap_existing_config_preserved": true,
      "bootstrap_existing_secret_preserved": true,
      "injected_error_propagated": true,
      "repeat_success": true
    },
    "component": "portainer",
    "objects": {
      "clusterrolebindings": [
        {
          "metadata": {
            "name": "portainer-crb-clusteradmin"
          },
          "roleRef": {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "ClusterRole",
            "name": "cluster-admin"
          },
          "subjects": [
            {
              "kind": "ServiceAccount",
              "name": "portainer-sa-clusteradmin",
              "namespace": "portainer"
            }
          ]
        }
      ],
      "clusterroles": null,
      "configmaps": [
        {
          "data": {
            "EDGE_ASYNC": "false",
            "EDGE_ID": "fixture-id",
            "EDGE_INSECURE_POLL": "0",
            "EDGE_SECRET": "fixture-secret"
          },
          "metadata": {
            "name": "portainer-agent-edge",
            "namespace": "portainer"
          }
        }
      ],
      "deployments": [
        {
          "metadata": {
            "name": "portainer-agent",
            "namespace": "portainer"
          },
          "spec": {
            "replicas": 1,
            "selector": {
              "matchLabels": {
                "app": "portainer-agent"
              }
            },
            "strategy": {},
            "template": {
              "metadata": {
                "labels": {
                  "app": "portainer-agent"
                }
              },
              "spec": {
                "containers": [
                  {
                    "env": [
                      {
                        "name": "LOG_LEVEL",
                        "value": "INFO"
                      },
                      {
                        "name": "EDGE",
                        "value": "1"
                      },
                      {
                        "name": "AGENT_CLUSTER_ADDR",
                        "value": "portainer-agent"
                      },
                      {
                        "name": "KUBERNETES_POD_IP",
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "status.podIP"
                          }
                        }
                      },
                      {
                        "name": "EDGE_KEY",
                        "valueFrom": {
                          "secretKeyRef": {
                            "key": "edge.key",
                            "name": "portainer-agent-edge-key"
                          }
                        }
                      },
                      {
                        "name": "AGENT_SECRET",
                        "valueFrom": {
                          "configMapKeyRef": {
                            "key": "EDGE_SECRET",
                            "name": "portainer-agent-edge",
                            "optional": true
                          }
                        }
                      }
                    ],
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "portainer-agent-edge"
                        }
                      }
                    ],
                    "image": "portainer/agent:fixture",
                    "imagePullPolicy": "IfNotPresent",
                    "name": "portainer-agent",
                    "ports": [
                      {
                        "containerPort": 9001,
                        "protocol": "TCP"
                      },
                      {
                        "containerPort": 80,
                        "protocol": "TCP"
                      }
                    ],
                    "resources": {}
                  }
                ],
                "serviceAccountName": "portainer-sa-clusteradmin"
              }
            }
          },
          "status": {}
        }
      ],
      "namespaces": [
        {
          "metadata": {
            "name": "portainer"
          },
          "spec": {},
          "status": {}
        }
      ],
      "rolebindings": null,
      "roles": null,
      "secrets": [
        {
          "metadata": {
            "name": "portainer-agent-edge-key",
            "namespace": "portainer"
          },
          "stringData": {
            "edge.key": "fixture-key"
          },
          "type": "Opaque"
        }
      ],
      "serviceaccounts": [
        {
          "metadata": {
            "name": "portainer-sa-clusteradmin",
            "namespace": "portainer"
          }
        }
      ],
      "services": [
        {
          "metadata": {
            "name": "portainer-agent",
            "namespace": "portainer"
          },
          "spec": {
            "clusterIP": "None",
            "ports": [
              {
                "name": "edge",
                "port": 9001,
                "protocol": "TCP",
                "targetPort": 0
              },
              {
                "name": "http",
                "port": 80,
                "protocol": "TCP",
                "targetPort": 0
              }
            ],
            "publishNotReadyAddresses": true,
            "selector": {
              "app": "portainer-agent"
            }
          },
          "status": {
            "loadBalancer": {}
          }
        }
      ],
      "storageclasses": null
    },
    "variant": "sync"
  },
