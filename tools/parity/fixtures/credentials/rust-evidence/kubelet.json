{
  "checks": {
    "kubeconfig_mode": "0600",
    "missing_parent_fails": true,
    "missing_referenced_credentials_accepted": true,
    "output_directory_fails": true,
    "refreshes_identity": true,
    "repeat_equal": true
  },
  "component": "kubelet",
  "path_kubeconfig": {
    "clusters": {
      "kubernetes": {
        "certificate-authority": "/fixture/ca.crt",
        "server": "https://192.0.2.8:6443"
      }
    },
    "contexts": {
      "system:node:fixture-node@kubernetes": {
        "cluster": "kubernetes",
        "user": "system:node:fixture-node"
      }
    },
    "current-context": "system:node:fixture-node@kubernetes",
    "users": {
      "system:node:fixture-node": {
        "client-certificate": "/fixture/node.crt",
        "client-key": "/fixture/node.key"
      }
    }
  }
}
