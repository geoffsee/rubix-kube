{
  "schema_version": 1,
  "id": "startup-contract-v1",
  "cases": [
    {
      "id": "version-exits-without-bootstrap",
      "argv": [
        "--version"
      ],
      "expect": {
        "exit_code": 0,
        "combined_contains": [
          "version"
        ]
      }
    },
    {
      "id": "print-config-exits-without-bootstrap",
      "argv": [
        "--print-config"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_contains": [
          "apiVersion: kubesolo.io/v1alpha1",
          "kind: Config"
        ]
      },
      "env": {
        "KUBESOLO_CONTAINER_MODE": "false"
      }
    }
  ]
}
