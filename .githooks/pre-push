#!/usr/bin/env bash
# Lint, tests, doctests, language policy, and dependency checks before commits leave this clone.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

run() {
    printf 'pre-push: %s\n' "$*"
    "$@"
}

run cargo lint
run cargo nextest run --locked --workspace --all-targets --all-features --profile ci
run cargo test --locked --workspace --doc --all-features
run cargo run --locked -p rubix-dev --bin rubix-language-policy
run cargo deny check
